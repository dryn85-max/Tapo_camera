# Скопировать в .env. go2rtc подставляет переменные окружения в go2rtc.yaml
# через синтаксис ${VAR}.

# IP камер (Fixed IP в UniFi Network)
TAPO1_IP=192.168.1.50
TAPO2_IP=192.168.1.51

# «Аккаунт камеры» из приложения Tapo (Расширенные настройки -> Аккаунт камеры).
# Только латиница и цифры.
TAPO_USER=camuser
TAPO_PASS=campass

# Логин/пароль RTSP-сервера go2rtc. Их вводят при адопте в UniFi Protect.
BRIDGE_USER=bridge
BRIDGE_PASS=bridgepass
